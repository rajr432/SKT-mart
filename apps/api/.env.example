# Database
DATABASE_URL="postgresql://sktmart:sktmart@localhost:5432/sktmart?schema=public"

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN=7d

# OTP (stub — integrate Firebase / Twilio in production)
OTP_PROVIDER=stub

# Razorpay (test keys — https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMTP (for order emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SKT Mart <no-reply@sktmart.com>"

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
